[Unit]
Description=OpenKey — bộ gõ tiếng Việt cho Wayland
Documentation=https://github.com/tuyenvm/OpenKey
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# -v + --log: dang o giai doan chan doan, ghi tung phim ra
# ~/.cache/openkey/openkeyd.log. Khi da on thi bo -v di.
ExecStart=%h/.local/bin/openkeyd -v --log %h/.cache/openkey/openkeyd.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
